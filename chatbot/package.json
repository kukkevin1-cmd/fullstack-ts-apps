{
  "name": "chatbot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n server,client \"npm:server\" \"npm:client\"",
    "server": "tsx watch src/server/index.ts",
    "client": "vite",
    "build": "tsc && vite build",
    "typecheck": "tsc",
    "test": "mocha --import=tsx 'src/**/*.test.ts'"
  },
  "dependencies": {
    "express": "^4.21.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.10.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/supertest": "^6.0.2",
    "@vitejs/plugin-react": "^4.4.1",
    "concurrently": "^9.1.2",
    "mocha": "^10.8.2",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.3.5"
  }
}
